# Working data is never versioned: event logs, caches, feature tables, predictions,
# label files and anything pulled from an agency system.
data/
archive/
review/
.tmp/
*.parquet
*.duckdb
*.duckdb.wal
*.pth
*.pbix
*.csv
__pycache__/
.ipynb_checkpoints/
.venv/

# --- but the shipped model IS versioned, including its weights and bundled sample ---
!model/
!model/**
model/**/__pycache__/

# --- and so are the research charts ---
!research/charts/
!research/charts/**

# third-party document, kept locally for reference, not redistributed
research/notes/*.pdf

# agency-specific download code: never committed
research/code/download/
