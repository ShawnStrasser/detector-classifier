{
 "name": "detector-classifier",
 "version": "beta_v0",
 "date": "2026-09-17",
 "status": "BETA - for integration testing; the final study scoring is still pending",
 "task": "From raw hi-res traffic-signal controller events, predict for every vehicle detector channel (1) the signal phase it is assigned to and (2) its function (Advance / Presence / Count / Other).",
 "pipeline": [
  "LightGBM phase-anonymous (detector, candidate phase) pair ranker",
  "LightGBM joint per-signal decoder (actuation-similarity + channel-adjacency neighbours, signal-level claims)",
  "optional ODOT standard-wiring tie-breaker (post-processing, default OFF)",
  "LightGBM function model (sibling-relative features, temperature scaled)",
  "label-free detector health flags -> status / review columns"
 ],
 "entry_point": "src/predict.py :: predict(events, start, end, odot_tiebreak)",
 "runtime": {
  "cpu_only": true,
  "python": ">=3.10",
  "requirements": "requirements-inference.txt",
  "total_model_bytes": 3909745,
  "total_model_mb": 3.73
 },
 "training_data": {
  "source": "ODOT hi-res controller logs (Indiana enumerations), 2024-12-02..04",
  "signals": 367,
  "split": "DEV = 375 signals with labels; the 43 TEST signals were not trained on",
  "labels": "detector-configs.csv: DeviceId, Detector, Phase, Function (5,171 labelled DEV detectors)",
  "training_windows": [
   "full72",
   "h1_a",
   "h1_b",
   "h1_c",
   "h24_a",
   "h24_b",
   "h3_a",
   "h3_b",
   "h6_a",
   "h6_b",
   "m10_a",
   "m10_b",
   "m10_c",
   "m10_d",
   "m30_a",
   "m30_b",
   "m30_c",
   "m30_d",
   "m5_a",
   "m5_b",
   "m5_c",
   "m5_d"
  ],
  "window_mix_note": "models are trained on a MIX of window lengths (5 min .. 72 h) so one model serves every sample duration",
  "allowed_event_codes": [
   1,
   7,
   8,
   9,
   10,
   11,
   43,
   44,
   81,
   82,
   83,
   84,
   85,
   86,
   87,
   88,
   131,
   150,
   173
  ],
  "excluded_by_protocol": "gap-out/max-out/force-off (4,5,6,13), overlaps (61-66), FYA (32/33), pedestrian events, preemption"
 },
 "components": {
  "phase_ranker": {
   "file": "phase_lgbm_v2.txt",
   "n_features": 261,
   "n_estimators": 243,
   "objective": "lambdarank",
   "feature_list_sha256": "0bba5b930796e512c72a9658cb9d1fa3591f2a0d33c3676aa597eccaf0f1ba74"
  },
  "joint_decoder": {
   "file": "decode_lgbm_v2.txt",
   "n_features": 25,
   "n_estimators": 155,
   "objective": "binary",
   "mode": "binary",
   "feature_list_sha256": "d3489b67fa1f481b3cf52532764e7b53dac3d47835c61203d60bd05a18cb0c92"
  },
  "function_model": {
   "file": "function_lgbm_v2.txt",
   "n_features": 314,
   "n_estimators": 149,
   "classes": [
    "Advance",
    "Presence",
    "Count"
   ],
   "feature_list_sha256": "a932ffb247f721c4ffd14d891e4e9ad3c5f0d92acb9837a91300ea2a3afa9591"
  }
 },
 "minimum_evidence_rule": {
  "min_actuations": 5,
  "parameter": "predict(..., min_actuations=5) / --min-actuations",
  "behaviour": "a detector with fewer ON events in the sample gets no answer: phase_pred / function_pred are blank, status is 'not enough data: N actuations in sample (need >= 5)', review_flag is true, and the model's raw opinion is kept in phase_guess / function_guess",
