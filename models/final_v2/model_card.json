 "pipeline": [
  "LightGBM pair ranker, 3 seeds averaged",
  "GRU + attention pair scorer on the 1 s raster, averaged in at weight 0.5 on samples up to 120 minutes (onnxruntime on the CPU, src/gru_onnx.py)",
